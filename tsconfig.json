{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@tui/*": ["./src/tui/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/index.ts",
    "src/cli/**/*.ts",
    "src/core/**/*.ts",
    "src/types/**/*.d.ts",
    "src/ui/**/*.ts",
    "src/tui/util/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/tui/**/*.tsx", "src/types/opentui.d.ts"]
}
