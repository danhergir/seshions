{
  "name": "seshions",
  "version": "0.2.0",
  "description": "OpenTUI-based Agent Management",
  "type": "module",
  "main": "launcher/seshions.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "launcher",
    "scripts/runtime",
    "README.md",
    "LICENSE",
    "install.sh",
    "uninstall.sh"
  ],
  "bin": {
    "seshions": "./launcher/seshions.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "compile": "bun run scripts/compile.ts",
    "compile:all": "bun run scripts/compile.ts --all",
    "release": "bun run scripts/release.ts",
    "postinstall": "node scripts/runtime/postinstall.mjs",
    "dev": "bun run scripts/build.ts && bun run dist/index.js",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.1.79",
    "@opentui/solid": "^0.1.79",
    "fuzzysort": "^3.0.0",
    "node-pty": "1.0.0",
    "remeda": "^2.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@tsconfig/bun": "^1.0.0",
    "@types/bun": "latest",
    "babel-preset-solid": "^1.8.0",
    "typescript": "^5.3.0"
  }
}
