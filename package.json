{
  "name": "seshions",
  "version": "0.3.0",
  "description": "Terminal session orchestrator for coding agents",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "seshions": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "node scripts/compile.mjs",
    "compile:all": "node scripts/compile.mjs --all",
    "release": "node scripts/release.mjs",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fuzzysort": "^3.0.0",
    "node-pty": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  }
}
